# Keep this file synchronized with src/lib/env.ts, deployment scripts, and README.md.
# Add every new environment variable here when runtime configuration changes.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/powerwash?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/powerwash?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Admin and customer link signing
# Both secrets must be at least 32 characters and unique. Production boots/builds
# fail closed when either is missing, too short, or left as a placeholder value.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
MANAGE_LINK_SECRET="replace-with-a-different-long-random-secret"

# Email
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Powerwash <bookings@example.com>"
SUPPORT_EMAIL="support@example.com"

# Optional seed overrides
# In production the seed script throws unless SEED_ADMIN_PASSWORD is set to a
# non-default value, so a public deploy cannot bootstrap the documented password.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional confirmation-page reconciliation tuning
CONFIRMATION_RECONCILE_DEBOUNCE_MS="30000"
CONFIRMATION_RECONCILE_MAP_MAX_SIZE="1000"

# Optional local-only booking form prefill
NEXT_PUBLIC_DEV_BOOKING_PREFILL_ENABLED="false"
NEXT_PUBLIC_DEV_BOOKING_PREFILL_JSON='{"firstName":"Jordan","lastName":"Taylor","email":"jordan@example.com","phone":"5551234567","make":"Toyota","model":"RAV4","year":"2022","color":"Pearl white","licensePlate":"8ABC123","notes":"Pet hair, child seats"}'
