generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum BalanceRequestDeliveryChannel {
  EMAIL
  SMS
}

enum BookingEventType {
  BOOKING_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  BALANCE_PAYMENT_REQUESTED
  BALANCE_PAYMENT_CONFIRMED
  BALANCE_PAYMENT_FAILED
  BOOKING_UPDATED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  ADMIN_NOTES_UPDATED
  REFUND_ISSUED
  MANAGE_LINK_ISSUED
  MANAGE_LINK_ROTATED
  BOOKING_ARCHIVED
  BOOKING_UNARCHIVED
}

model Service {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  durationMinutes Int
  basePrice       Decimal   @db.Decimal(10, 2)
  depositAmount   Decimal   @db.Decimal(10, 2)
  isActive        Boolean   @default(true)
  bookings        Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Booking {
  id                      String        @id @default(cuid())
  serviceId               String
  firstName               String
  lastName                String
  email                   String
  phone                   String
  vehicleDescription      String
  vehicleColor            String?
  vehicleLicensePlate     String?
  customerNotes           String?
  startAt                 DateTime
  endAt                   DateTime
  status                  BookingStatus @default(PENDING_PAYMENT)
  paymentStatus           PaymentStatus @default(PENDING)
  totalPrice              Decimal       @db.Decimal(10, 2)
  depositAmount           Decimal       @db.Decimal(10, 2)
  balanceDue              Decimal       @db.Decimal(10, 2)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  adminNotes              String?
  paymentExpiresAt        DateTime?
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  manageTokenVersion      Int           @default(0)
  manageTokenRotatedAt    DateTime?
  manageLinkSentAt        DateTime?
  refundAmount            Decimal?      @db.Decimal(10, 2)
  refundReason            String?
  refundedAt              DateTime?
  stripeRefundId          String?       @unique
  stripeBalanceRefundId   String?       @unique
  balanceRequestVersion   Int           @default(0)
  balanceRequestedAt      DateTime?
  balanceRequestDeliveryChannel BalanceRequestDeliveryChannel?
  balanceRequestDestination String?
  balanceCheckoutSessionId String?      @unique
  balancePaymentIntentId  String?       @unique
  balancePaidAt           DateTime?
  archivedAt              DateTime?
  archivedByAdminUserId   String?
  customerAccessEndsAt    DateTime?
  service                 Service       @relation(fields: [serviceId], references: [id])
  archivedByAdminUser     AdminUser?    @relation("ArchivedBookings", fields: [archivedByAdminUserId], references: [id])
  events                  BookingEvent[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([startAt, endAt])
  @@index([status, paymentStatus])
  @@index([archivedAt, startAt])
}

model BookingEvent {
  id               String           @id @default(cuid())
  bookingId        String
  type             BookingEventType
  actorAdminUserId String?
  actorLabel       String?
  beforeState      Json?
  afterState       Json?
  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorAdminUser   AdminUser?       @relation("BookingEvents", fields: [actorAdminUserId], references: [id])
  createdAt        DateTime         @default(now())

  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek, isActive])
}

model BlackoutDate {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, endsAt, isActive])
}

model AdminUser {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  name              String
  isActive          Boolean        @default(true)
  lastLoginAt       DateTime?
  archivedBookings  Booking[]      @relation("ArchivedBookings")
  bookingEvents     BookingEvent[] @relation("BookingEvents")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}
