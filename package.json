{
  "name": "powerwash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build && node ./scripts/prepare-standalone.mjs",
    "build:app": "next build && node ./scripts/prepare-standalone.mjs",
    "build:vercel": "node ./scripts/vercel-build.mjs",
    "start": "node .next/standalone/server.js",
    "test": "node --experimental-strip-types src/lib/booking-prefill.test.ts",
    "start:railway": "sh ./scripts/start.sh",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:check": "node ./scripts/check-bootstrap.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.0",
    "next": "^16.2.4",
    "prisma": "^6.18.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
